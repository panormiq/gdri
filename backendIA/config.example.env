# Configuration BackendIA
# Copiez ce fichier en .env et personnalisez les valeurs

# Database MongoDB
database_url=mongodb://backend_user:Bn0n0t4t4!@localhost:27017/backend_ia

# JWT Configuration
secret_key=Bonjour je m'appelle backendIA je repond à tes prompt.
algorithm=HS256
access_token_expire_minutes=30

# Ollama Configuration
ollama_base_url=http://localhost:11434
ollama_model=mistral:latest

# Backend principal
main_backend_url=http://localhost:3000
standalone_mode=True

# Service Tokens (CHANGEZ CES VALEURS EN PRODUCTION !)
CRON_SERVICE_TOKEN=cron-service-token-987654321-xyz
ADMIN_SERVICE_TOKEN=admin-service-token-456789123-abc
# Token pour l'API gateway (backend Node / module ia) - POST /api/generate
IA_SERVICE_TOKEN=ia-service-token-gdri-gateway

# Development Token (DÉSACTIVER EN PRODUCTION !)
DEV_TOKEN=dev-token-123456789-quick-access
enable_dev_token=True

# Application
app_name=BackendIA
debug=True


