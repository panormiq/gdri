# Configuration MongoDB - Super Admin
# ⚠️ IMPORTANT : Copiez ce fichier en .env et remplissez les valeurs réelles
# Ne jamais commiter le fichier .env dans Git !

# Super Admin MongoDB (uniquement pour création d'entreprises)
# Cet utilisateur doit avoir les rôles : readWriteAnyDatabase, dbAdminAnyDatabase, userAdminAnyDatabase
MONGO_ADMIN_USER=gdri_admin_setup
MONGO_ADMIN_PASSWORD="CHANGER_EN_PRODUCTION_MOT_DE_PASSE_FORT"

# Clé de chiffrement pour les credentials MongoDB des entreprises
# ⚠️ DOIT FAIRE 32 CARACTÈRES MINIMUM
# Utilisée pour chiffrer les mots de passe des utilisateurs MongoDB par entreprise
CREDENTIALS_ENCRYPTION_KEY="CHANGER_EN_PRODUCTION_32_CHARS_MINIMUM"

# Secret JWT (optionnel, si différent de la config par défaut)
# JWT_SECRET="gdri-2024-secret-key-change-in-production"

# Version de l’API Graph Facebook utilisée par le module Facebook (routes, OAuth, SDK fb)
# Exemple : v21.0 (défaut si variable absente)
# FACEBOOK_GRAPH_VERSION=v21.0

# SMTP de repli pour les entités sans profil SMTP configuré (ex. envoi d'emails Facebook / analyse d'intention)
# Si SMTP_HOST, SMTP_USER, SMTP_PASS sont définis, le profil "gdri_app" (app@gdr-innovation.fr) est utilisé automatiquement.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=app@gdr-innovation.fr
# SMTP_PASS=votre_mot_de_passe
# Optionnel : GDRI_APP_SMTP_FROM_EMAIL=app@gdr-innovation.fr  GDRI_APP_SMTP_FROM_NAME=GDRI

# Doc-Hub — liens de téléchargement dans les emails (base API publique, avec /api)
# Par défaut : https://www.gdr-innovation.fr/api (config.json + ignore localhost)
# BACKEND_API_URL=https://www.gdr-innovation.fr/api
# En dev local uniquement si vous voulez des liens localhost :
# DOC_HUB_USE_LOCAL_LINKS=true

# Module IA (priorité : serveur IA backendIA, sinon Ollama direct)
# Si définis, le backend Node appelle backendIA au lieu d'Ollama directement
# IA_SERVER_URL=http://localhost:8000
# IA_SERVICE_TOKEN=ia-service-token-gdri-gateway
# En dev backendIA accepte aussi : BACKENDIA_DEV_TOKEN=dev-token-123456789-quick-access

# Security Monitor - ban immédiat des IPs attaquantes
# Activer/désactiver le ban immédiat par type d'attaque applicative
# IMMEDIATE_BAN_ENABLED=true
# Types séparés par virgule (ex: sensitive_file_access,sql_injection,directory_traversal)
# IMMEDIATE_BAN_ATTACK_TYPES=sensitive_file_access
# Durée du ban en millisecondes (ex: 24h = 86400000)
# AUTO_BAN_DURATION_MS=86400000
# IPs/CIDR de confiance jamais bannies (séparées par virgule)
# AUTO_BAN_TRUSTED_IPS=127.0.0.1,192.168.0.0/16,10.0.0.0/8
# Éviter de bannir les IPs proxy Cloudflare visibles dans Apache (recommandé: true)
# AUTO_BAN_SKIP_CLOUDFLARE_PROXY_IPS=true

# Rate limiting /api — IPs exclues du quota (dev + prod, CIDR supportés)
# Utilise aussi AUTO_BAN_TRUSTED_IPS si RATE_LIMIT_TRUSTED_IPS est absent
# RATE_LIMIT_TRUSTED_IPS=127.0.0.1,VOTRE_IP_PUBLIQUE,VOTRE_RESEAU_BUREAU/24
# Requêtes max par minute par IP (défaut 100 ; UGAP peut nécessiter 300–500)
# RATE_LIMIT_MAX=300

# Environnement PHP (frontend GDRI, erreurs affichées, boutons dev UGAP si development)
# Valeurs : development | production
# Prioritaire sur la détection auto (localhost / branche Git). Ne pas commiter en prod.
# ENVIRONMENT=development

# Boutons dev UGAP uniquement (ex. « Supprimer toutes les familles ») sans passer tout le site en development
# UGAP_DEV_MODE=true
