{
  "id": "action",
  "name": "Action",
  "version": "4.1.0",
  "family": "action",
  "category": "action",
  "kind": "action",
  "visibility": "orchestrator-only",
  "description": "Champs à préparer pour la suite (IA, mail…), ou accrocher une page déjà dessinée dans le flux.",
  "palette": {
    "children": [
      {
        "id": "hook",
        "name": "Hook",
        "iconEmoji": "🪝",
        "description": "Chaîne éditeur (choix du hook) reliée à la chaîne exécution (ajouter le hook au flux).",
        "place": "insertable",
        "templateId": "agent-hook",
        "hookSurface": "palette"
      }
    ]
  },
  "canvas": {
    "iconEmoji": "⚙",
    "color": "#7c3aed",
    "borderRadius": 12,
    "width": 220,
    "inputs": [
      { "id": "main", "label": "Entrée", "type": "main", "maxConnections": 0 }
    ],
    "outputs": [
      { "id": "main", "label": "Suite", "type": "main", "maxConnections": 0 }
    ]
  },
  "operations": {
    "action.run": {
      "label": "Exécuter",
      "configSchema": {
        "type": "object",
        "properties": {
          "writeMode": {
            "type": "string",
            "title": "Écriture dans le flux",
            "enum": ["merge", "replace"],
            "enumLabels": {
              "merge": "Compléter le flux",
              "replace": "Écraser le texte"
            },
            "default": "merge"
          },
          "fieldsFrom": {
            "type": "string",
            "title": "Champs depuis",
            "description": "Slug du bloc Entrées (ex. collection_design) : le tableau nom / type devient les champs de l’action.",
            "default": ""
          },
          "copyFrom": {
            "type": "string",
            "title": "Copier un objet du flux",
            "description": "Objet amont (ex. mail.item). Tous les champs sont préremplis ; tu peux en surcharger n’importe lequel.",
            "default": ""
          }
        }
      },
      "outputMessage": {
        "type": "action-result",
        "fields": [
          { "key": "success", "label": "Succès" }
        ]
      }
    }
  },
  "permissions": ["network"],
  "serviceRef": "backend/core/agent-flow/families"
}
