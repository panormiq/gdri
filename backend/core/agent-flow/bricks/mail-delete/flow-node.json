{
  "id": "mail-delete",
  "name": "Supprimer mail",
  "version": "1.0.0",
  "category": "connector",
  "kind": "action",
  "visibility": "orchestrator-only",
  "description": "Supprime le message IMAP d'origine (UID/sourceRef du mail-in) après validation humaine.",
  "canvas": {
    "iconEmoji": "🗑️",
    "color": "#dc2626",
    "borderRadius": 12,
    "width": 220,
    "inputs": [
      { "id": "main", "label": "Entrée", "type": "main", "maxConnections": 1 }
    ],
    "outputs": [
      { "id": "main", "label": "OK", "type": "main" }
    ]
  },
  "operations": {
    "mail.delete": {
      "label": "Supprimer le message IMAP",
      "description": "Delete IMAP via UID du message déclencheur (uniquement après approve).",
      "configSchema": {
        "type": "object",
        "properties": {
          "accountRef": {
            "type": "string",
            "title": "Compte mail (optionnel)",
            "description": "Vide = accountRef du message mail-in"
          },
          "mailbox": {
            "type": "string",
            "title": "Dossier IMAP",
            "default": "INBOX"
          },
          "onlyOnApprove": {
            "type": "boolean",
            "title": "Uniquement si décision = approve",
            "default": true
          }
        }
      },
      "outputMessage": {
        "type": "mail-delete-result",
        "fields": ["success", "uid", "action"]
      }
    }
  },
  "permissions": ["network", "secrets"],
  "serviceRef": "backend/core/agent-flow/bricks/mail-delete"
}
