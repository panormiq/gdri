{
  "id": "logic-if",
  "name": "Si / If",
  "version": "1.1.0",
  "category": "logic",
  "kind": "action",
  "visibility": "orchestrator-only",
  "description": "Si un champ du contexte (fourni par les blocs amont) vérifie une condition → sortie Oui, sinon → Non. Choisissez le champ dans la liste, pas en texte libre.",
  "canvas": {
    "iconEmoji": "◇",
    "color": "#0ea5e9",
    "borderRadius": 12,
    "width": 200,
    "inputs": [
      { "id": "main", "label": "Entrée", "type": "main", "maxConnections": 1 }
    ],
    "outputs": [
      { "id": "true", "label": "Oui", "type": "main" },
      { "id": "false", "label": "Non", "type": "main" }
    ]
  },
  "operations": {
    "logic.if": {
      "label": "Condition",
      "configSchema": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "title": "Champ du contexte",
            "format": "context-field",
            "default": "",
            "description": "Liste construite depuis les blocs amont (connecteur, analyse…)"
          },
          "op": {
            "type": "string",
            "title": "Condition",
            "enum": ["contains", "eq", "neq", "truthy", "falsy", "gt", "lt"],
            "enumLabels": {
              "contains": "contient",
              "eq": "est égal à",
              "neq": "est différent de",
              "truthy": "est renseigné",
              "falsy": "est vide",
              "gt": "supérieur à",
              "lt": "inférieur à"
            },
            "default": "contains"
          },
          "value": {
            "type": "string",
            "title": "Valeur",
            "default": ""
          }
        }
      },
      "outputMessage": {
        "type": "logic-if-result",
        "fields": [
          { "key": "condition", "label": "Résultat (oui/non)" },
          { "key": "field", "label": "Champ testé" },
          { "key": "actual", "label": "Valeur trouvée" }
        ]
      }
    }
  },
  "permissions": [],
  "serviceRef": "backend/core/agent-flow/bricks/logic-if"
}
