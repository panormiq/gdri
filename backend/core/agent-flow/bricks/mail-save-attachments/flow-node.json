{
  "id": "mail-save-attachments",
  "name": "Télécharger PJ",
  "version": "1.0.0",
  "category": "connector",
  "kind": "action",
  "visibility": "orchestrator-only",
  "description": "Enregistre les pièces jointes du mail (déjà récupérées par mail-in) dans un dossier téléchargements et expose des liens de download.",
  "canvas": {
    "iconEmoji": "⬇️",
    "color": "#059669",
    "borderRadius": 12,
    "width": 220,
    "inputs": [
      { "id": "main", "label": "Entrée", "type": "main", "maxConnections": 1 }
    ],
    "outputs": [
      { "id": "main", "label": "Fichiers", "type": "main" }
    ]
  },
  "operations": {
    "mail.saveAttachments": {
      "label": "Enregistrer les pièces jointes",
      "description": "Copie les PJ du message vers uploads/downloads pour téléchargement.",
      "configSchema": {
        "type": "object",
        "properties": {
          "subfolder": {
            "type": "string",
            "title": "Sous-dossier (optionnel)",
            "description": "ex. factures-gw — vide = date du jour",
            "default": "factures"
          },
          "requireAttachments": {
            "type": "boolean",
            "title": "Échouer s'il n'y a aucune PJ",
            "default": false
          }
        }
      },
      "outputMessage": {
        "type": "mail-attachments-saved",
        "fields": [
          { "key": "attachments", "label": "Fichiers enregistrés" },
          { "key": "count", "label": "Nombre" },
          { "key": "folderUrl", "label": "Dossier" }
        ]
      }
    }
  },
  "permissions": ["entity-data"],
  "serviceRef": "backend/core/agent-flow/bricks/mail-save-attachments"
}
