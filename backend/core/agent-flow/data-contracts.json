{
  "version": "1.6.1",
  "description": "Contrat des données renvoyées par le bloc Entrées. Toujours un tableau. Un mail / commentaire / document simple = 1 ligne. Le nom du bloc est le tableau ({{#donnees}}). item = ligne courante (choix par défaut). items = toutes les lignes. text/from/subject = ligne courante.",
  "envelope": {
    "id": "canonical",
    "label": "Tableau canonique",
    "example": {
      "channel": "mail",
      "itemsCount": 1,
      "itemIndex": 0,
      "text": "Bonjour, pouvez-vous me faire un devis pour 3 bureaux ?",
      "from": "Marie Dupont <marie.dupont@client.fr>",
      "subject": "Demande de devis — 3 bureaux",
      "messageId": "evt-8f3a2c",
      "sourceRef": "1842",
      "timestamp": "2026-08-17T08:12:00.000Z",
      "author": { "id": "u-12", "name": "Marie Dupont", "email": "marie.dupont@client.fr" },
      "instanceId": "inst-mail-support",
      "items": [
        {
          "text": "Bonjour, pouvez-vous me faire un devis pour 3 bureaux ?",
          "from": "Marie Dupont <marie.dupont@client.fr>",
          "subject": "Demande de devis — 3 bureaux",
          "messageId": "evt-8f3a2c",
          "sourceRef": "1842",
          "author": { "id": "u-12", "name": "Marie Dupont", "email": "marie.dupont@client.fr" }
        }
      ]
    },
    "fields": [
      { "key": "item", "label": "Item (ligne courante)", "type": "object", "example": { "text": "Bonjour" } },
      { "key": "items", "label": "Tableau (toutes les lignes)", "type": "array", "example": [{ "text": "Bonjour", "from": "Marie Dupont" }] },
      { "key": "itemsCount", "label": "Nombre de lignes", "type": "number", "example": 1 },
      { "key": "itemIndex", "label": "Index de la ligne courante", "type": "number", "example": 0 },
      { "key": "channel", "label": "Canal", "type": "string", "example": "mail" },
      { "key": "text", "label": "Texte (ligne courante)", "type": "string", "example": "Bonjour, pouvez-vous me faire un devis pour 3 bureaux ?" },
      { "key": "name", "label": "Nom (ligne courante)", "type": "string", "example": "Marie Dupont" },
      { "key": "from", "label": "Auteur / expéditeur (ligne courante)", "type": "string", "example": "Marie Dupont <marie.dupont@client.fr>" },
      { "key": "subject", "label": "Sujet (ligne courante)", "type": "string", "connectors": ["mail"], "example": "Demande de devis — 3 bureaux" },
      { "key": "attachments", "label": "Pièces jointes (ligne courante)", "type": "array", "connectors": ["mail"], "example": [{ "filename": "plan.pdf", "contentType": "application/pdf" }] },
      { "key": "messageId", "label": "ID message", "type": "string", "example": "evt-8f3a2c" },
      { "key": "sourceRef", "label": "Référence source", "type": "string", "example": "1842" },
      { "key": "timestamp", "label": "Horodatage", "type": "datetime", "example": "2026-08-17T08:12:00.000Z" },
      { "key": "author.id", "label": "ID auteur", "type": "string", "example": "u-12" },
      { "key": "author.name", "label": "Nom auteur", "type": "string", "example": "Marie Dupont" },
      { "key": "author.email", "label": "Email auteur", "type": "string", "connectors": ["mail"], "example": "marie.dupont@client.fr" },
      { "key": "instanceId", "label": "Instance connecteur", "type": "string", "example": "inst-mail-support" }
    ]
  },
