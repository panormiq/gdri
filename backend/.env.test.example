# Copier vers backend/.env.test et adapter si besoin.
# Ne pas committer .env.test (secrets).

GDRI_ENV_FILE=.env.test
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
ENVIRONMENT=test

# Base principale de test (clonée depuis GDR-INNOVATION)
MONGODB_DB=GDR-INNOVATION-TEST
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=gdri_admin
MONGODB_PASSWORD=gdri2024
# authSource = où vit l'utilisateur Mongo (souvent la base prod)
MONGODB_AUTH_SOURCE=GDR-INNOVATION

# Reprendre les mêmes secrets que backend/.env :
# MONGO_ADMIN_USER=...
# MONGO_ADMIN_PASSWORD=...
# CREDENTIALS_ENCRYPTION_KEY=...
# SMTP_HOST=...
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...
# GDRI_APP_SMTP_FROM_EMAIL=...
# GDRI_APP_SMTP_FROM_NAME=GDRI
