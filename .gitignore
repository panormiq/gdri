# Dépendances
node_modules/
vendor/
frontend/vendor/

# Fichiers de configuration locaux
.env
.env.local
.env.test
*.env.local
frontend/config/config.local.php

# État runtime moniteur sécurité (ne pas committer)
backend/.security-monitor-state.json

# Fichiers de cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Sauvegardes MongoDB (fichiers générés)
backend/storage/backups/**
!backend/storage/backups/.gitkeep

# Bases de données locales
*.db
*.sqlite
*.sqlite3
app.db
backendIA/app.db

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fichiers système
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Fichiers temporaires
*.tmp
*.temp
test-urls.php
restore-*.txt
restore-*.json
restore-*.js

# Uploads locaux (médias générés)
backend/uploads/media-studio/**
!backend/uploads/media-studio/.gitkeep

# Certificats SSL (à ne pas commiter)
ssl-certs/*.key
ssl-certs/*.crt
ssl-certs/*.pem

# Fichiers de build
dist/
build/
