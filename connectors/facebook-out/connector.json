{
  "id": "facebook-out",
  "name": "Facebook (sortant)",
  "version": "1.1.0",
  "author": "GDR-Innovation",
  "description": "Publication sur le fil de la page, ou réponse (commentaire / MP).",
  "direction": "output",
  "compatiblePlatform": ">=1.0.0",
  "audience": "contact",
  "hosts": ["annuaire"],
  "capabilities": [
    "emit.reply",
    "emit.publish"
  ],
  "credentials": {
    "type": "oauth2",
    "provider": "facebook",
    "scopes": [
      "pages_messaging",
      "pages_manage_posts",
      "pages_manage_engagement",
      "pages_read_engagement"
    ]
  },
  "settingsFields": [
    {
      "key": "pageId",
      "label": "ID Page Facebook (optionnel)",
      "type": "text"
    },
    {
      "key": "action",
      "label": "Action par défaut",
      "type": "enum",
      "enum": ["publish", "reply"],
      "enumLabels": { "publish": "Publier", "reply": "Répondre" },
      "default": "publish"
    },
    {
      "key": "replyMode",
      "label": "Canal de réponse",
      "type": "enum",
      "enum": ["auto", "comment", "post", "message"],
      "enumLabels": {
        "auto": "Auto",
        "comment": "Commentaire",
        "post": "Publication",
        "message": "Message privé"
      },
      "default": "auto"
    },
    {
      "key": "graphVersion",
      "label": "Version Graph API",
      "type": "text",
      "default": "v21.0"
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "pageId": {
        "type": "string",
        "title": "ID Page Facebook (optionnel)"
      },
      "action": {
        "type": "string",
        "title": "Action par défaut",
        "enum": ["publish", "reply"],
        "default": "publish"
      },
      "replyMode": {
        "type": "string",
        "title": "Canal de réponse",
        "enum": ["auto", "comment", "post", "message"],
        "default": "auto"
      },
      "graphVersion": {
        "type": "string",
        "title": "Version Graph API",
        "default": "v21.0"
      }
    }
  },
  "operations": {
    "emit.publish": {
      "description": "Publie un post (texte / lien / image) sur le fil de la page"
    },
    "emit.reply": {
      "description": "Répond à un commentaire, commente un post, ou envoie un MP"
    }
  },
  "instanceDefaults": {
    "ingestModes": [],
    "settings": {
      "action": "publish",
      "replyMode": "auto",
      "graphVersion": "v21.0"
    },
    "mapping": {}
  },
  "permissions": ["network", "secrets", "entity-data"]
}
