{
  "id": "mail-in",
  "name": "Mail entrant",
  "version": "1.1.0",
  "author": "GDR-Innovation",
  "description": "Réception d'emails via IMAP (poll planifié ou manuel), avec pièces jointes et filtres optionnels.",
  "direction": "input",
  "compatiblePlatform": ">=1.0.0",
  "audience": "contact",
  "hosts": ["annuaire"],
  "capabilities": [
    "ingest.poll",
    "emit.delete",
    "emit.seen"
  ],
  "credentials": {
    "type": "basic",
    "inheritsFrom": "mail-infra",
    "fields": ["accountRef"]
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "accountRef": {
        "type": "string",
        "title": "Compte mail (infra)",
        "description": "Référence du compte configuré dans Paramètres > Mail"
      },
      "mailbox": {
        "type": "string",
        "title": "Dossier IMAP",
        "default": "INBOX"
      },
      "pollIntervalMinutes": {
        "type": "number",
        "title": "Intervalle de poll (minutes)",
        "minimum": 1,
        "default": 3
      },
      "unseenOnly": {
        "type": "boolean",
        "title": "Uniquement non lus",
        "default": true
      },
      "includeAttachments": {
        "type": "boolean",
        "title": "Télécharger les pièces jointes",
        "default": true
      },
      "fromContains": {
        "type": "string",
        "title": "Filtre expéditeur (contient)",
        "description": "Ex. games workshop — vide = tous",
        "default": ""
      },
      "subjectContains": {
        "type": "string",
        "title": "Filtre sujet (contient)",
        "description": "Ex. invoice — vide = tous",
        "default": ""
      },
      "pollLimit": {
        "type": "number",
        "title": "Max messages par poll",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      }
    },
    "required": ["accountRef"]
  },
  "operations": {
    "ingest.poll": {
      "description": "Lecture IMAP périodique (avec PJ si activé)"
    },
    "emit.delete": {
      "description": "Supprime un message IMAP par UID"
    },
    "emit.seen": {
      "description": "Marque un message IMAP comme lu"
    }
  },
  "instanceDefaults": {
    "ingestModes": ["poll"],
    "settings": {
      "mailbox": "INBOX",
      "pollIntervalMinutes": 3,
      "unseenOnly": true,
      "includeAttachments": true,
      "fromContains": "",
      "subjectContains": "",
      "pollLimit": 20
    },
    "mapping": {
      "text": "text",
      "author.email": "fromEmail",
      "author.name": "fromName",
      "sourceRef": "uid",
      "metadata.subject": "subject"
    }
  },
  "permissions": ["network", "secrets", "entity-data"]
}
